DATABASE_URL=
SESSION_SECRET=
# JSON array of {code, id, name, role}; roles: fan, artist, admin, juror
APP_INVITES=[]
# Separate server-only reviewer invitations, same {id,name,role,code} format.
REVIEWER_INVITES=[]
META_API_KEY=
META_MODEL=muse-spark-1.3
META_JUDGE_MODEL=muse-spark-1.2
ENABLE_META_AUDIO_JUDGING=false
META_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
FFMPEG_PATH=
C2PA_CERT_PATH=
C2PA_KEY_PATH=
C2PA_CERT_BASE64=
C2PA_KEY_BASE64=
C2PA_TRUST_ANCHORS_PATH=
C2PA_TIMESTAMP_URL=
STORY_PRIVATE_KEY=
STORY_SPG_NFT_CONTRACT=
STORY_RPC_URL=https://aeneid.datarpc.io
PINATA_JWT=
PINATA_GATEWAY=
CUSTODY_MASTER_KEY=
TRACE_ENABLED=false
TRACE_API_KEY=
TRACE_PROVIDER=
# Server-only agent credentials: [{id, ownerId, name, key, focus}]
AGENT_IDENTITIES=[]
# x402 receiving configuration; public address only. Receiving does not authorize payouts.
X402_PAY_TO=
X402_NETWORK=eip155:8453
X402_TEST_PAY_TO=
X402_TEST_NETWORK=eip155:84532
# CDP facilitator authentication; store as Vercel Secrets, never Safe signing keys.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Selected providers: provision real dashboard apps before enabling their integrations.
ALCHEMY_API_KEY=
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
PRIVY_APP_SECRET=
# Server-side Web Push signing identity. Only the public key is sent to clients.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
CRON_SECRET=
