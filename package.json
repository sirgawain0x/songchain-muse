{
  "name": "agent-stage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "setup:local": "node scripts/setup-local.mjs",
    "setup:test-signer": "node scripts/setup-test-signer.mjs",
    "test:provenance": "tsx --env-file=.env.local scripts/check-provenance.ts",
    "test:api": "node --env-file=.env.local scripts/check-api.mjs",
    "test:reviews": "tsx --env-file=.env.local scripts/check-reviews.ts",
    "test:x402": "tsx --env-file=.env.local scripts/check-x402.ts",
    "env:sync": "node scripts/sync-env.mjs",
    "test:auth": "tsx --env-file=.env.local scripts/check-privy.ts",
    "test:preview": "tsx --env-file=.env.local scripts/check-listening-preview.ts"
  },
  "dependencies": {
    "@contentauth/c2pa-node": "latest",
    "@neondatabase/serverless": "^1.0.2",
    "@privy-io/node": "^0.37.0",
    "@privy-io/react-auth": "^3.51.0",
    "@story-protocol/core-sdk": "latest",
    "@stripe/stripe-js": "^10.2.0",
    "@x402/core": "^2.29.0",
    "@x402/evm": "^2.29.0",
    "@x402/next": "^2.29.0",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "pinata": "^2.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "viem": "^2.38.0",
    "web-push": "3.6.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "3.6.4",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "decode-uri-component": "0.5.1",
    "ws@>=8.0.0 <8.22.1": "8.22.1"
  }
}
